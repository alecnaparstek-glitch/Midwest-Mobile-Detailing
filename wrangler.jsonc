{
  "name": "midwest-mobile-detailing",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_COORDINATOR",
        "class_name": "BookingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "booking-v1",
      "new_sqlite_classes": [
        "BookingCoordinator"
      ]
    }
  ]
}
