<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#ff580b"><meta name="description" content="Midwest Mobile Detailing — interior, exterior and complete detailing in Olathe, Overland Park and Leawood, Kansas."><title>About | Midwest Mobile Detailing</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="styles.css"></head><body data-page="about"><div id="app"></div><script src="app.js" defer></script></body></html>
const A='assets/';const packages=[{id:'interior',name:'Midwest Inside Out',kind:'Interior Detail',img:'interior.jpg',prices:[159,179,239],duration:'2 hr 30 min',features:['Full interior vacuum','Deep clean all interior surfaces','Clean windows and mirrors','Detailed door panels and trim','Optional pet hair removal add-on']},{id:'exterior',name:'Midwest Fresh Finish',kind:'Exterior Detail',img:'exterior.jpg',prices:[109,129,149],duration:'1 hr 30 min',features:['Hand wash and rinse','Clean wheels and tires','Tire dressing','Apply Bead Maker sealant','Clean exterior glass']},{id:'complete',name:'Midwest Full Reset',kind:'Complete Detail',img:'complete.jpg',prices:[229,259,299],duration:'4 hours',features:['Everything in the interior detail','Everything in the exterior detail','Deep clean carpets and mats','Extended interior detailing','Long-lasting paint protection topper']},{id:'maintenance',name:'Midwest Keep It Clean',kind:'Monthly Maintenance',img:'bucket-brand.jpg',prices:[89,109,null],duration:'By arrangement',features:['Regular exterior cleaning','Maintain interior cleanliness','Keep a fresh, like-new look','Priority scheduling','Custom plan based on your vehicle']}];const page=document.body.dataset.page;const nav=[['index.html','Home','index'],['services.html','Services','services'],['booking.html','Booking','booking'],['about.html','About','about']];const header=()=>`<header class="site-header"><div class="wrap header-inner"><a href="index.html" aria-label="Midwest Mobile Detailing home"><img class="logo" src="${A}logo.jpg" alt="Midwest Mobile Detailing"></a><nav class="nav-links" id="nav-links">${nav.map(n=>`<a class="${page===n[2]?'active':''}" href="${n[0]}">${n[1]}</a>`).join('')}</nav><a href="booking.html" class="btn small header-book">Book Now →</a><button class="menu-toggle" aria-label="Open navigation" onclick="document.getElementById('nav-links').classList.toggle('open')">☰</button></div></header>`;const foot=()=>`<footer><div class="wrap"><span>© ${new Date().getFullYear()} Midwest Mobile Detailing · Olathe · Overland Park · Leawood</span><span>Locally owned · Water and power access required · <a href="booking.html">Request a detail →</a></span></div></footer>`;const banner=(title,subtitle)=>`<section class="page-banner"><h1>${title}</h1><p>${subtitle}</p></section>`;const benefits=()=>`<div class="benefits"><div class="benefit"><span class="ico">♧</span><div><strong>Mobile Service</strong><span>We come to you</span></div></div><div class="benefit"><span class="ico">◇</span><div><strong>Premium Results</strong><span>Inside & out</span></div></div><div class="benefit"><span class="ico">▦</span><div><strong>Easy Booking</strong><span>Request in minutes</span></div></div></div>`;const serviceCards=()=>`<section class="orange-section"><div class="wrap"><div class="section-head"><div class="eyebrow">OUR SERVICES</div><h2>Detailing Packages<br>Built for the Midwest</h2><p>Choose the package that fits your vehicle and your needs.</p></div><div class="service-grid">${packages.map(p=>`<article class="service-card"><img src="${A+p.img}" alt="${p.kind}" loading="lazy"><h3>${p.name}</h3><p class="sub">${p.kind}</p><div class="from">From</div><div class="price">$${p.prices[0]}${p.id==='maintenance'?'<small style="font-size:13px">/mo</small>':''}</div><a class="btn" href="services.html#${p.id}">View Details</a></article>`).join('')}</div></div></section>`;const quizTeaser=()=>`<div class="wrap"><div class="quiz-teaser"><img src="${A}interior.jpg" alt="Clean vehicle interior"><div class="copy"><div class="eyebrow" style="color:var(--orange)">NOT SURE WHAT YOU NEED?</div><h3>Take Our Quick Quiz</h3><p>Answer a few questions and we'll recommend the perfect Midwest package for your vehicle.</p><button class="btn" onclick="openQuiz()">Start Quiz →</button></div></div></div>`;const area=()=>`<section class="area-band"><div class="wrap"><div class="area-card"><div class="pin">📍</div><div><div class="eyebrow" style="color:var(--orange)">SERVICE AREA</div><h2>Olathe, Overland Park,<br>Leawood</h2><p>Professional mobile detailing throughout these Johnson County communities.</p></div></div></div></section>`;const home=()=>`<section class="hero"><div class="wrap hero-content"><div class="eyebrow">OLATHE · OVERLAND PARK · LEAWOOD</div><h1>A Cleaner Car<br>Brings a <em>Brighter<br>Day.</em></h1><p>Professional mobile detailing in Olathe, Overland Park, and Leawood. Premium results, right at your home.</p><a class="btn" href="booking.html">Book Your Detail →</a></div></section>${benefits()}${quizTeaser()}${serviceCards()}<section class="dark-strip"><div class="wrap"><h2>Premium Detailing.<br>Right to Your Driveway.</h2><a class="btn" href="booking.html">Book Now →</a></div></section>${area()}${faq()}`;const detail=()=>`${banner('Detailing Packages','Four packages. Built for any vehicle. Professional results, brought to you.')}<section class="section"><div class="wrap detail-list">${packages.map(p=>`<article class="detail-card" id="${p.id}"><img src="${A+p.img}" alt="${p.kind}"><div class="detail-info"><h2>${p.name.replace(' ','<br>')}</h2><div class="sub">${p.kind.toUpperCase()}</div><ul>${p.features.map(f=>`<li>${f}</li>`).join('')}</ul></div><div class="detail-prices">${p.prices.map((v,i)=>v===null?'':`<div><span class="size">${['Sedan','SUV','Oversized'][i]}</span><strong>$${v}${p.id==='maintenance'?'<small style="font-size:12px">/mo</small>':''}</strong></div>`).join('')}<a class="btn" href="booking.html?package=${p.id}">Book Now →</a></div></article>`).join('')}<div class="soft-box"><h3>Not sure which package is right for you?</h3><p>Take our quick quiz and get a personalized recommendation.</p><button class="btn" onclick="openQuiz()">Start the Quiz →</button></div></div></section><section class="addon-banner"><div class="wrap"><div class="eyebrow">ADDITIONAL SERVICES</div><h2>Make it yours.</h2><div class="addon-pill">🐾 Pet Hair Removal · Quote based on condition</div></div></section>${area()}${faq()}`;const faq=()=>`<section class="section"><div class="wrap"><h2 style="font:800 40px 'Barlow Condensed',Impact,sans-serif;text-transform:uppercase;margin:0 0 18px">Frequently Asked Questions</h2><div class="faq"><details><summary>Do I need to provide water and electricity?</summary><p>Yes. We ask customers to provide access to an outdoor water hookup and a standard electrical outlet at the service location.</p></details><details><summary>When do I pay?</summary><p>Payment is due after the detail is complete. No online payment is required when requesting an appointment.</p></details><details><summary>Is my appointment confirmed when I request it?</summary><p>No. Appointment requests are reviewed first, and you'll receive confirmation after approval. Online request submission is not active in this preview.</p></details><details><summary>Can you remove pet hair?</summary><p>Yes, pet hair removal is available as an add-on. The final charge depends on how much removal is needed.</p></details><details><summary>Which areas do you serve?</summary><p>Olathe, Overland Park, and Leawood, Kansas.</p></details></div></div></section>`;const about=()=>`${banner('About Midwest Mobile Detailing','Local detailing. Quality work. A business built on care.')}<section class="section"><div class="wrap about-grid"><div><div class="eyebrow" style="color:var(--orange)">ABOUT MIDWEST MOBILE DETAILING</div><h2>Made for the Midwest.<br>Built on hard work.</h2><p>Midwest Mobile Detailing was built on a simple idea — high-quality detailing, right at your home. Based in Olathe, we serve Overland Park, Leawood, and the surrounding area with professional interior and exterior detailing.</p><p>As a young, local business owner, I take pride in delivering a great experience, attention to detail, and results that speak for themselves.</p><a class="btn" href="booking.html">Book Your Detail →</a></div><img src="${A}bucket-brand.jpg" alt="Midwest branded detailing bucket"></div></section>${benefits()}${area()}${faq()}`;let booking={step:0,pack:new URLSearchParams(location.search).get('package')||'',size:0,pet:false,date:'',time:'',name:'',phone:'',address:'',city:'Olathe',notes:''};const steps=['Service','Vehicle','Date & Time','Details'];const bookingPage=()=>`${banner('Book Your Detail','Premium detailing, brought to you. Request an appointment below.')}<section class="section"><div class="wrap"><div class="booking-shell"><div class="booking-progress">${steps.map((s,i)=>`<div class="progress-item ${booking.step===i?'active':booking.step>i?'done':''}"><b>${i+1}</b><strong>${s}</strong><span>${['Select your package','Tell us about your car','Choose your availability','Confirm your request'][i]}</span></div>`).join('')}</div><div id="booking-panel" class="booking-panel"></div></div></div></section><section class="dark-strip"><div class="wrap"><h2>Professional Detailing.<br>Right to Your Driveway.</h2></div></section>${area()}`;function drawBooking(){const e=document.getElementById('booking-panel');if(!e)return;let p=packages.find(x=>x.id===booking.pack);if(booking.step===0)e.innerHTML=`<h2>Select a Package</h2><div class="package-choices">${packages.map(x=>`<button class="package-choice ${booking.pack===x.id?'selected':''}" onclick="choosePack('${x.id}')"><img src="${A+x.img}" alt=""><strong>${x.name}</strong><small>${x.kind}</small></button>`).join('')}</div><div class="actions"><span></span><button class="btn" ${booking.pack?'':'disabled'} onclick="nextBooking()">Next Step →</button></div>`;if(booking.step===1)e.innerHTML=`<h2>Tell Us About Your Vehicle</h2><p class="muted">Select the size that best matches your vehicle.</p><div class="option-row">${['Sedan / Coupe','SUV / Crossover','Oversized / 3-row'].map((x,i)=>`<button class="chip ${booking.size===i?'selected':''}" onclick="setSize(${i})">${x}</button>`).join('')}</div><p><strong>${p.name}</strong> · ${p.prices[booking.size]===null?'Contact for pricing':'$'+p.prices[booking.size]} · ${p.duration}</p><label style="display:flex;align-items:center;gap:10px"><input type="checkbox" ${booking.pet?'checked':''} onchange="booking.pet=this.checked"> Add pet hair removal (quoted based on condition)</label><div class="actions"><button class="btn secondary" onclick="prevBooking()">← Back</button><button class="btn" onclick="nextBooking()">Next Step →</button></div>`;if(booking.step===2)e.innerHTML=`<h2>Choose Your Preferred Date & Time</h2><p class="warning">This is a design preview. Live availability and appointment requests are not connected yet. The date and time you choose here will not reserve a slot.</p><div class="field-grid" style="margin-top:18px"><label class="field">Preferred date<input type="date" min="${new Date().toISOString().slice(0,10)}" value="${booking.date}" onchange="booking.date=this.value"></label><label class="field">Preferred start time<select onchange="booking.time=this.value"><option value="">Choose a time</option>${['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00'].map(t=>`<option value="${t}" ${booking.time===t?'selected':''}>${new Date('2000-01-01T'+t).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})}</option>`).join('')}</select></label></div><div class="actions"><button class="btn secondary" onclick="prevBooking()">← Back</button><button class="btn" onclick="nextBooking()">Next Step →</button></div>`;if(booking.step===3)e.innerHTML=`<h2>Your Details</h2><p class="muted">${p.name} · ${['Sedan','SUV','Oversized'][booking.size]} · ${p.prices[booking.size]===null?'Quote required':'$'+p.prices[booking.size]} · ${booking.date||'Date not selected'} ${booking.time||''}</p><div class="field-grid"><label class="field">Full name<input placeholder="Your name" oninput="booking.name=this.value" value="${escapeHtml(booking.name)}"></label><label class="field">Phone number<input type="tel" placeholder="(555) 555-5555" oninput="booking.phone=this.value" value="${escapeHtml(booking.phone)}"></label><label class="field full">Service address<input placeholder="Street address" oninput="booking.address=this.value" value="${escapeHtml(booking.address)}"></label><label class="field">City<select onchange="booking.city=this.value">${['Olathe','Overland Park','Leawood'].map(c=>`<option ${booking.city===c?'selected':''}>${c}</option>`).join('')}</select></label><label class="field full">Vehicle condition / notes<textarea placeholder="Anything we should know about your vehicle?" oninput="booking.notes=this.value">${escapeHtml(booking.notes)}</textarea></label></div><p class="warning" style="margin-top:17px"><strong>Preview only:</strong> This form cannot submit appointments yet. We will connect a secure booking backend, real availability, and notifications before launch. No personal information entered here is sent or saved.</p><div class="actions"><button class="btn secondary" onclick="prevBooking()">← Back</button><button class="btn" disabled>Request Appointment (Coming Soon)</button></div>`}function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function choosePack(id){booking.pack=id;drawBooking()}function setSize(n){booking.size=n;drawBooking()}function nextBooking(){if(booking.step<3){booking.step++;drawBooking();document.querySelector('.booking-shell').scrollIntoView({behavior:'smooth',block:'start'})}}function prevBooking(){if(booking.step>0){booking.step--;drawBooking()}}let quizStep=0,quizAnswers=[];const quizQuestions=[{q:'What does your vehicle need most?',a:['The interior needs attention','The exterior needs attention','Both inside and outside','Just regular upkeep']},{q:'How long has it been since your last thorough detail?',a:['Within the last month','1–3 months','More than 3 months','Not sure']},{q:'What is your biggest concern?',a:['Dirty seats, carpets or surfaces','Paint, wheels or road grime','A complete refresh','Keeping a clean car clean']},{q:'How often would you like it cleaned?',a:['Just this once','Every month','Every few months','I am not sure']}];function openQuiz(){quizStep=0;quizAnswers=[];document.getElementById('quiz-overlay').classList.add('open');drawQuiz()}function closeQuiz(){document.getElementById('quiz-overlay').classList.remove('open')}function drawQuiz(){let e=document.getElementById('quiz-content');if(quizStep<quizQuestions.length){let q=quizQuestions[quizStep];e.innerHTML=`<div class="eyebrow" style="color:var(--orange)">PACKAGE FINDER · ${quizStep+1} OF 4</div><h2>${q.q}</h2><div class="quiz-options">${q.a.map((v,i)=>`<button onclick="answerQuiz(${i})">${v} →</button>`).join('')}</div>`}else{let votes=[0,0,0,0];votes[quizAnswers[0]]+=3;votes[quizAnswers[2]]+=2;if(quizAnswers[3]===1)votes[3]+=3;let idx=votes.indexOf(Math.max(...votes));let p=packages[idx];e.innerHTML=`<div class="eyebrow" style="color:var(--orange)">YOUR MIDWEST MATCH</div><h2>${p.name}</h2><p>${p.kind} · Starting at $${p.prices[0]}${idx===3?'/mo':''}</p><img src="${A+p.img}" alt="${p.kind}" style="height:180px;width:100%;object-fit:cover;border-radius:10px;margin:15px 0"><a class="btn" href="booking.html?package=${p.id}">Choose This Package →</a>`}}function answerQuiz(n){quizAnswers.push(n);quizStep++;drawQuiz()}document.getElementById('app').innerHTML=header()+(page==='index'?home():page==='services'?detail():page==='booking'?bookingPage():about())+foot()+`<div class="quiz-overlay" id="quiz-overlay" onclick="if(event.target===this)closeQuiz()"><div class="quiz-dialog"><button class="quiz-close" aria-label="Close quiz" onclick="closeQuiz()">×</button><div id="quiz-content"></div></div></div>`;if(page==='booking')drawBooking();
